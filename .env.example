# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/truein

# ---------- JWT ----------
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email / SMTP (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PunchIn <no-reply@punchin.app>"

# ---------- Misc ----------
GEOFENCE_RADIUS_METERS=100

# ---------- Face recognition ----------
# Minimum 1:1 face-match confidence (0..1, higher = stricter) required to allow
# a face punch-in. Also used by the AI Time Guard. Raise toward 0.85 for high
# security. A score of 0.6 ≈ a euclidean descriptor distance of 0.4.
FACE_MATCH_THRESHOLD=0.6
# Set false on hosts that can't run @tensorflow/tfjs-node — face punch-in is
# then rejected rather than silently bypassed.
FACE_ENGINE_ENABLED=true
# Where the face-api model weights live. Defaults to server/models/.
# Populate with: cd server && npm run download-face-models
FACE_MODELS_PATH=
# Quality gates for a usable capture.
FACE_MIN_DETECTION_SCORE=0.6
FACE_MIN_FACE_SIZE=90

# ---------- Client (Vite, must be prefixed with VITE_) ----------
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
